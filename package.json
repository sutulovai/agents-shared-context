{
  "name": "agents-shared-context",
  "version": "0.1.0",
  "description": "Project-scoped coordination for concurrent OpenCode sessions using local Redis leases",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutulovai/agents-shared-context.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "format:check": "prettier --check src test .github .agents AGENTS.md package.json tsconfig.json README.md",
    "check:public": "node test/public-tree.mjs",
    "pretest": "node test/require-redis.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:managed": "npm run build && node --test test/managed.mjs",
    "test:acceptance": "node test/suite.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "ioredis": "^5.8.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  }
}
